generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PlacementDrive {
  id             String   @id @default(cuid())
  companyName    String
  role           String
  driveDate      DateTime
  eligibleBranch String
  minCGPA        Float?
  jobType        String?
  details        String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
