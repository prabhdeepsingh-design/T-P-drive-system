# GNDEC TNP Placement Drive Manager Environment Variables

# PostgreSQL Database Connection URL (Prisma connection string)
# Replace user, password, host, port, and database name with your PostgreSQL credentials
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tnp_drives?schema=public"

# Optional Next.js Port (Default: 3000)
PORT=3000

# Administrator Password for Secure Placement Drive Deletion
# Must be set to a strong password in production and local .env
ADMIN_DELETE_PASSWORD="replace-with-a-strong-admin-password"
